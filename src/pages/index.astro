---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Jessica Smith</h1>
			<p>
				Software engineer writing about AI-assisted development, dotfiles automation, and whatever
				else I end up building. See the <a href="/blog">blog</a> for posts.
			</p>
		</main>
		<Footer />
	</body>
</html>
